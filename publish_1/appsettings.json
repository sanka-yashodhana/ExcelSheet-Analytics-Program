{
  "Urls": "http://0.0.0.0:5239",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=EmployeeExcelAnalyticsDB;Integrated Security=True;TrustServerCertificate=True;"
    
  },

  "ExcelImport": {
    "MaxFileSizeMB": 100,
    "MaxRecords": 500000,
    "BatchSize": 1000,
    "MaxInlineErrors": 100,
    "TempStoragePath": "App_Data/Imports"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
